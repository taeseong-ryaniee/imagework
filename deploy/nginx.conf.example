# Deploy this file at the public edge before the Node.js server. Replace only
# the local upstream endpoint to match the private Imagework service process.
# TLS certificate, key, and public hostname configuration intentionally belong
# to the host's secret-managed virtual-host configuration, not this repository.

limit_req_zone $binary_remote_addr zone=imagework_process_per_ip:10m rate=6r/m;

upstream imagework_next {
    server 127.0.0.1:3000;
}

server {
    listen 443 ssl;
    server_name _;

    # Configure TLS with host-managed certificate directives before enabling.
    # include /etc/nginx/snippets/imagework-tls.conf;

    client_max_body_size 1m;
    client_body_timeout 30s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 75s;
    proxy_read_timeout 120s;
    limit_req_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location = /api/process {
        client_max_body_size 11m;
        limit_req zone=imagework_process_per_ip burst=3 nodelay;
        proxy_pass http://imagework_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering on;
    }

    location = /api/process/cancel {
        limit_req zone=imagework_process_per_ip burst=12 nodelay;
        proxy_pass http://imagework_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # status is polled repeatedly across a job's lifetime (up to
    # IMAGEWORK_JOB_TIMEOUT_SECONDS), so it gets the largest burst; result is
    # downloaded once and occasionally retried, so a smaller burst is enough.
    location = /api/process/status {
        limit_req zone=imagework_process_per_ip burst=30 nodelay;
        proxy_pass http://imagework_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/process/result {
        limit_req zone=imagework_process_per_ip burst=10 nodelay;
        proxy_pass http://imagework_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://imagework_next;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
