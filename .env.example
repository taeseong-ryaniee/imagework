# Imagework server worker configuration / Imagework 서버 워커 설정
#
# Copy this file to a server-only `.env` file, or inject these exact names with
# your deployment secret manager. Do not commit the completed `.env` file.
# 이 파일을 서버 전용 `.env`로 복사하거나 배포 Secret Manager에서 같은 이름으로
# 주입하세요. 실제 값이 입력된 `.env` 파일은 절대 커밋하지 마세요.
#
# These values must never use a `NEXT_PUBLIC_` name or appear in browser code,
# URLs, responses, logs, or result archives.
# 이 값은 `NEXT_PUBLIC_` 변수, 브라우저 코드, URL, 응답, 로그, 결과 압축 파일에
# 절대 포함하면 안 됩니다.

# Required secret: Hugging Face token for an account approved for facebook/sam3.
# 필수 비밀값: facebook/sam3 접근 승인을 받은 Hugging Face 계정의 토큰입니다.
IMAGEWORK_HF_TOKEN=

# Required secret: a random 32–512 character processing access code. Generate
# one with `openssl rand -hex 32` and rotate it if it may have been disclosed.
# 필수 비밀값: 무작위 32–512자 처리 접근 코드입니다. `openssl rand -hex 32`로
# 생성하고 노출 가능성이 있으면 교체하세요.
IMAGEWORK_PROCESSING_CODE=

# Required non-secret: only noninteractive Application Default Credentials are
# supported. Set this to `adc`; `colab version` must print exactly `Version: 0.6.0`.
# 필수 일반값: 비대화형 Application Default Credentials만 지원합니다. Colab CLI는
# 정확히 `Version: 0.6.0`이어야 합니다.
IMAGEWORK_COLAB_AUTH_MODE=

# Required secret-file path: absolute path to a server-only authorized-user ADC
# JSON file for an identity entitled to allocate a Colab GPU (for example,
# `/run/secrets/imagework-google-adc.json`). Never paste the JSON contents here
# or commit the referenced file.
# 필수 비밀 파일 경로: Colab GPU 권한이 있는 ADC JSON의 서버 전용 절대 경로입니다.
IMAGEWORK_GOOGLE_APPLICATION_CREDENTIALS=

# Required private path: absolute parent for isolated per-job Colab CLI state.
# Use a path such as `/var/lib/imagework/colab`; do not use a developer home
# directory or a directory shared with the web app.
# 필수 비공개 경로: 작업별 Colab CLI 상태를 위한 절대 상위 경로입니다. 개발자 홈이나
# 웹 앱과 공유하는 디렉터리는 사용하지 마세요.
IMAGEWORK_COLAB_CONFIG=

# Required non-secret: requested GPU accelerator. Set this to `T4`; it is the
# only supported accelerator.
# 필수 일반값: 요청할 GPU 가속기입니다. T4만 지원합니다.
IMAGEWORK_COLAB_ACCELERATOR=

# Required non-secret: complete-job timeout in seconds, from 30 through 7200.
# Start with 1800 and configure the reverse-proxy read timeout above it.
# 필수 일반값: 전체 작업 제한 시간(초)이며 30–7200 범위입니다. 처음에는 1800을
# 사용하고 리버스 프록시 읽기 제한 시간을 이보다 길게 설정하세요.
IMAGEWORK_JOB_TIMEOUT_SECONDS=

# Required deployment path: absolute path to the reviewed remote worker included
# with this release, for example `/srv/imagework/runner/remote-worker.py`. Keep
# it read-only to the Imagework service account.
# 필수 배포 경로: 이 릴리스에 포함된 검토 완료 원격 워커의 절대 경로입니다.
IMAGEWORK_JOB_SCRIPT=

# Required private path: absolute parent for temporary upload and download data.
# Use a path such as `/var/lib/imagework/jobs`. Every job directory is deleted
# when the job finishes.
# 필수 비공개 경로: 임시 업로드/다운로드 데이터의 절대 상위 경로입니다. 각 작업
# 디렉터리는 종료 시 삭제됩니다.
IMAGEWORK_JOB_TMP_ROOT=

# Required private path: absolute root for no-payload crash-recovery markers.
# Use a path such as `/var/lib/imagework/recovery`. Store no images, archives,
# credentials, or raw CLI output in this directory.
# 필수 비공개 경로: 내용 없는 장애 복구 마커 전용 절대 경로입니다. 이미지, 압축 파일,
# 자격 증명, 원본 CLI 출력은 이곳에 저장하지 마세요.
IMAGEWORK_RECOVERY_ROOT=

# Required non-secret: total running-plus-queued job limit, integer 1–100.
# A low-traffic single worker should begin with 1.
# 필수 일반값: 실행/대기 작업 합계 한도이며 1–100 정수입니다. 저트래픽 단일 워커는
# 1부터 시작하세요.
IMAGEWORK_MAX_QUEUE_DEPTH=
