# Server worker only. Keep this file value-free and never prefix any of these
# variables with NEXT_PUBLIC_. Inject real values through the deployment secret
# manager, outside this repository.

# Hugging Face token for the server worker account with access to facebook/sam3.
IMAGEWORK_HF_TOKEN=

# Google Colab CLI authentication. Only noninteractive ADC is supported.
# The runner requires `colab version` to return exactly `Version: 0.6.0`.
IMAGEWORK_COLAB_AUTH_MODE=
# Absolute server-only ADC credential JSON file. The runner copies it into each job.
IMAGEWORK_GOOGLE_APPLICATION_CREDENTIALS=
# Absolute path to a private parent directory for per-job Colab CLI state. The
# worker creates each job's --config file and HOME/XDG directories beneath it.
IMAGEWORK_COLAB_CONFIG=

# Per-job runner controls.
IMAGEWORK_COLAB_ACCELERATOR=
IMAGEWORK_JOB_TIMEOUT_SECONDS=
# Absolute path to reviewed shared request-processing code. It must contain no
# Hugging Face token, Google credential, or per-job user data.
IMAGEWORK_PROCESSING_CODE=
# Absolute path to the reviewed, read-only processing entrypoint deployed with the worker.
IMAGEWORK_JOB_SCRIPT=
# Parent directory for per-job temporary input/output directories; it must not be shared
# with the web process and each job directory must be deleted after completion.
IMAGEWORK_JOB_TMP_ROOT=
# Private no-payload crash-recovery marker root and bounded in-memory queue depth.
IMAGEWORK_RECOVERY_ROOT=
IMAGEWORK_MAX_QUEUE_DEPTH=
