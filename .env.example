# Imagework server worker configuration / Imagework 서버 워커 설정
#
# Copy this file to a server-only `.env` file, or inject these exact names with
# your deployment secret manager. Do not commit the completed `.env` file.
# 이 파일을 서버 전용 `.env`로 복사하거나 배포 Secret Manager에서 같은 이름으로
# 주입하세요. 실제 값이 입력된 `.env` 파일은 절대 커밋하지 마세요.
#
# These values must never use a `NEXT_PUBLIC_` name or appear in browser code,
# URLs, responses, logs, or result archives.
# 이 값은 `NEXT_PUBLIC_` 변수, 브라우저 코드, URL, 응답, 로그, 결과 압축 파일에
# 절대 포함하면 안 됩니다.
#
# The Hugging Face token never lives in this runtime `.env`; it is injected as
# a one-time environment variable only while running the provisioning script.
# Hugging Face 토큰은 이 런타임 `.env`에 들어가지 않으며, 프로비저닝 스크립트
# 실행 시에만 환경 변수로 1회 주입됩니다.

# Required secret: a random 32–512 character processing access code. Generate
# one with `openssl rand -hex 32` and rotate it if it may have been disclosed.
# 필수 비밀값: 무작위 32–512자 처리 접근 코드입니다. `openssl rand -hex 32`로
# 생성하고 노출 가능성이 있으면 교체하세요.
IMAGEWORK_PROCESSING_CODE=

# Required deployment path: absolute path to the venv Python interpreter that
# runs the local worker, for example `/srv/imagework/venv/bin/python`.
# 필수 배포 경로: 로컬 워커를 실행하는 venv Python 인터프리터의 절대 경로입니다.
IMAGEWORK_WORKER_PYTHON=

# Required deployment path: absolute path to the reviewed local worker script
# included with this release, for example `/srv/imagework/runner/local-worker.py`.
# Keep it read-only to the Imagework service account.
# 필수 배포 경로: 이 릴리스에 포함된 검토 완료 로컬 워커 스크립트의 절대 경로입니다.
IMAGEWORK_WORKER_SCRIPT=

# Required private path: absolute parent for the shared SAM3 model cache and
# the GPU single-ownership lock file. Use a path such as
# `/var/lib/imagework/models`.
# 필수 비공개 경로: 공유 SAM3 모델 캐시와 GPU 단일 소유권 락 파일의 절대 상위
# 경로입니다.
IMAGEWORK_MODEL_CACHE=

# Required deployment path: absolute path to the VTracer executable built
# during provisioning, for example `/srv/imagework/bin/vtracer`.
# 필수 배포 경로: 프로비저닝 중 빌드된 VTracer 실행 파일의 절대 경로입니다.
IMAGEWORK_VTRACER_BIN=

# Required non-secret: complete-job timeout in seconds, from 30 through 600.
# Start with 300.
# 필수 일반값: 전체 작업 제한 시간(초)이며 30–600 범위입니다. 처음에는 300을
# 사용하세요.
IMAGEWORK_JOB_TIMEOUT_SECONDS=

# Required private path: absolute parent for temporary upload and download data.
# Use a path such as `/var/lib/imagework/jobs`. Every job directory is deleted
# when the job finishes.
# 필수 비공개 경로: 임시 업로드/다운로드 데이터의 절대 상위 경로입니다. 각 작업
# 디렉터리는 종료 시 삭제됩니다.
IMAGEWORK_JOB_TMP_ROOT=

# Required non-secret: seconds a finished job's result is retained for download
# before it is deleted. Defaults to 600.
# 필수 일반값: 작업 완료 후 결과 파일을 다운로드 대기 상태로 보관하는 시간(초)이며,
# 지나면 삭제됩니다. 기본값은 600입니다.
IMAGEWORK_RESULT_TTL_SECONDS=

# Required non-secret: total running-plus-queued job limit, integer 1–100.
# A low-traffic single worker should begin with 1.
# 필수 일반값: 실행/대기 작업 합계 한도이며 1–100 정수입니다. 저트래픽 단일 워커는
# 1부터 시작하세요.
IMAGEWORK_MAX_QUEUE_DEPTH=
